# Copy this file to .env, then paste your keys below.
#   cp .env.example .env

# ===== PASTE YOUR KEYS HERE =====
OPENAI_API_KEY=
# Optional, only used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# =================================

# --- Database (dev: `pnpm db:up` starts Postgres in Docker on port 54329) ---
DATABASE_URL=postgres://moldbusters:moldbusters_dev_only@localhost:54329/moldbusters

# --- Private object storage (local filesystem driver; never served directly) ---
STORAGE_DRIVER=local
STORAGE_ROOT=./.data/storage
# HMAC secret for short-lived signed media URLs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_SIGNING_SECRET=dev-only-change-me-storage-secret-0000000000

# --- Sessions / auth ---
SESSION_SECRET=dev-only-change-me-session-secret-000000000000
APP_URL=http://localhost:3100
# Shows a one-click staff login on /admin/login. NEVER enable outside local dev.
DEV_LOGIN_ENABLED=true

# --- AI models ---
# Provider: openai (default) | anthropic | mock (offline pixel heuristic for demos/tests only).
# After setting a key, run: pnpm ai:check
AI_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_TEXT_MODEL=gpt-4.1
# USD per 1M tokens, used for cost tracking only. Verify against current OpenAI pricing.
OPENAI_PRICE_INPUT_PER_MTOK=2
OPENAI_PRICE_OUTPUT_PER_MTOK=8
AI_VISION_MODEL=claude-opus-5-5
AI_TEXT_MODEL=claude-opus-5-5
AI_MAX_FRAMES_PER_RUN=12
AI_BUDGET_USD_PER_RUN=1.50

# --- Media limits (provisional; confirm with business) ---
MEDIA_MAX_UPLOAD_BYTES=524288000
MEDIA_MAX_VIDEO_SECONDS=600
MEDIA_FRAME_INTERVAL_SECONDS=2

# --- Feature flags (production default: all off until approved) ---
FEATURE_BILLING=false
FEATURE_REPORT_PUBLISHING=true
FEATURE_EXTERNAL_INTEGRATIONS=false
FEATURE_REFERRALS=false

# --- Dev sample test button (/assess/new). Local development only; disabled in production. ---
SAMPLE_VIDEO_PATH=
